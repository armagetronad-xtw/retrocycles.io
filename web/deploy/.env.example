# copy to .env next to docker-compose.yml and fill in
AA_SITE_ADDRESS=play.example.com     # DNS name of the host (automatic HTTPS); ":80" for a local http test
AA_PUBLIC_IP=203.0.113.10            # the host's public IPv4, advertised in ICE candidates
AA_SERVER_NAME=My browser server
AA_GAME_PORT=4534                    # UDP, for desktop clients
AA_ICE_PORT_MIN=50000                # UDP range for the browser clients' DataChannels, published 1:1
AA_ICE_PORT_MAX=50019
AA_TALK_TO_MASTER=1                  # announce to the master servers (desktop clients find it)
AA_SERVER_IMAGE=aa-server-webrtc     # your image of a WebRTC-enabled dedicated server (README.md)
#AA_SITE_DIR=../dist                 # the bundle from "make dist"
#AA_RESOURCE_DIR=./resource          # local override directory of the resource proxy (<host>/<path> layout)
#AA_RESOURCE_UPSTREAMS=resource.armagetronad.net   # hosts the /resource/ proxy may fetch from (regex alternation: a|b:8080)
#AA_RESOURCE_CORS_ORIGIN=*           # Access-Control-Allow-Origin the proxy sends
